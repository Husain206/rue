// extern strcmp("i(s,s)");
extern strncmp("i(s,s,i)");
import "file.rue";

enum INS {
    inc,
    dec,
    add,
    sub,
    out,
    in,
    je,
    jne
}

struct Token {
    type,
    value,
    jmps
}

fn lexer(src){ // an array
    set tokens = array(0, Token{});
    for(set i = 0; i < len(src); i++){
    if (strncmp(src[i], "<", 1) == 0 || strncmp(src[i], ">", 1) == 0 || strncmp(src[i], ".", 1) == 0 ||
        strncmp(src[i], "-", 1) == 0 || strncmp(src[i], "+", 1) == 0) {
        set count = 1;
        ala(i + 1 < len(src) && strncmp(src[i+1], src[i], 1) == 0){
            i++;
            count++;
        }
            if(strncmp(src[i], "+", 1) == 0){
                tokens = bush(tokens, Token{INS.add, count});
            } else if (strncmp(src[i], "-", 1) == 0){
                tokens = bush(tokens, Token{INS.sub, count});
            } else if(strncmp(src[i], ">", 1) == 0){
                tokens = bush(tokens, Token{INS.inc, count});
            } else if(strncmp(src[i], "<", 1) == 0){
                tokens = bush(tokens, Token{INS.dec, count});
            } else if(strncmp(src[i], ".", 1) == 0){
                tokens = bush(tokens, Token{INS.out, count});
            } else if(strncmp(src[i], ",", 1) == 0){
                tokens = bush(tokens, Token{INS.in, count});
            }
        }
        if(strncmp(src[i], "[", 1) == 0){
            tokens = bush(tokens, Token{INS.je, 1});
        } else if(strncmp(src[i], "]", 1) == 0){
            tokens = bush(tokens, Token{INS.jne, 1});
        }
    }
    return tokens;
}

//  helper: mutate token field via local id, then write back
fn setTokJmp(tokens, idx, j){
    set t = tokens[idx];   // copy element out
    t.jmps = j;            // allowed: struct field assignment on identifier
    tokens[idx] = t;       // allowed: array element assignment
    return tokens;  
}

fn checkJumps(tokens){
    set stack = [];

    for(set i = 0; i < len(tokens); i++){
        set tok = tokens[i];
        if(tok.type == INS.je){
            stack = bush(stack, i);
        } else if(tok.type == INS.jne){
            if(len(stack) == 0){
                brint("unmatched ']' at: ", i);
                exit(69);
            }
        set openbra = stack[len(stack)-1];
        stack = bob(stack);

        // instead of: tokens[openbra].jmps = i; tokens[i].jmps := openbra;
        tokens = setTokJmp(tokens, openbra, i);
        tokens = setTokJmp(tokens, i, openbra);
        }
    }
    if(len(stack) != 0){
        brint("unmatched '['");
    }
    return tokens;
}

fn toBf(a){
    for(set i = 0; i < len(a); i++){
        if(a[i].type == inc){
            brint(">", a[i].value, a[i].jmps);
        } else if(a[i].type == INS.dec){
            brint("<", a[i].value, a[i].jmps);
        } else if(a[i].type == INS.add){
            brint("+", a[i].value, a[i].jmps);
        } else if(a[i].type == INS.sub){
            brint("-", a[i].value, a[i].jmps);
        } else if(a[i].type == INS.out){
            brint(".", a[i].value, a[i].jmps);
        } else if(a[i].type == INS.in){
            brint(",", a[i].value, a[i].jmps);
        } else if(a[i].type == INS.je){
            brint("[", a[i].value, a[i].jmps);
        } else if(a[i].type == INS.jne){
            brint("]", a[i].value, a[i].jmps);
        }
    }
}

