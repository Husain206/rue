fn wrap8(x){
    return ((x % 256) + 256) % 256;
}


fn interpreter(tokens){
    set mem = array(10000, 0);
    set ptr = 5000;
    set ip = 0;            // instruction pointer

    ala(ip < len(tokens)){
        set tok = tokens[ip];

        if(tok.type == INS.inc){
            ptr += tok.value;

        } else if(tok.type == INS.dec){
            ptr -= tok.value;

        } else if(tok.type == INS.add){
            // mem[ptr] = mem[ptr] + tok.value;
            mem[ptr] = wrap8(mem[ptr] + tok.value);
        } else if(tok.type == INS.sub){
            // mem[ptr] = mem[ptr] - tok.value;
            mem[ptr] = wrap8(mem[ptr] - tok.value);
        } else if(tok.type == INS.out){
            for(set j = 0; j < tok.value; j++){
                print(chr(mem[ptr]));
            }

        } else if(tok.type == INS.in){
            print "later input";

        } else if(tok.type == INS.je){
            if(mem[ptr] == 0){
                ip = tok.jmps;   // jump to matching ]
            }

        } else if(tok.type == INS.jne){
            if(mem[ptr] != 0){
                ip = tok.jmps;   // jump back to matching [
            }
        }

        ip += 1;   
        // brint("ip:", ip, "ptr:", ptr, "cell:", mem[ptr], "tok:", tok.type, tok.value);
    }
    // return mem;
}


fn main(args){

    // toBf(checkJumps(lexer("++++++++[>++++++++<-]>+.")));
    set file = readf("hello.txt");
    interpreter(checkJumps(lexer(file)));

    // interpreter(checkJumps(lexer("++++++++[>++++++++<-]>+.")));
    return 0;
}
